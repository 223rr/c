#include <windows.h>
#include "resource.h"

1 ICON "app.ico"

IDR_PAYLOAD RCDATA "TaskJournal.exe"
IDR_README  RCDATA "readme.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "223rr"
            VALUE "FileDescription",  "Task Journal Installer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TaskJournalSetup"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "TaskJournal-Setup.exe"
            VALUE "ProductName",      "Task Journal"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
